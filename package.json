{
  "name": "latex-on-ipad",
  "private": true,
  "scripts": {
    "build:lint-worker": "esbuild js-src/lint-worker.js --bundle --platform=browser --format=iife --minify --outfile=js/lint-worker.js",
    "build:tex-worker": "esbuild js-src/tex-worker.js --bundle --platform=browser --format=iife --minify --outfile=js/tex-worker.js",
    "build:assets": "node scripts/copy-assets.js",
    "build": "npm run build:lint-worker && npm run build:tex-worker && npm run build:assets",
    "test": "node --test tests/*.test.js"
  },
  "dependencies": {
    "@unified-latex/unified-latex-util-pegjs": "1.8.4",
    "glyphtex-engine": "0.1.4",
    "pdfjs-dist": "6.5.438"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.7"
  }
}
